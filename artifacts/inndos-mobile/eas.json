{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "prebuildCommand": "npx expo prebuild --no-install",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      }
    },
    "preview": {
      "autoIncrement": true,
      "environment": "production",
      "distribution": "store",
      "prebuildCommand": "npx expo prebuild --no-install",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "https://inndos.com"
      },
      "ios": {
        "distribution": "store"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "prebuildCommand": "npx expo prebuild --no-install",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "https://inndos.com"
      },
      "ios": {
        "distribution": "store"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
