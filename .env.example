# Required environment variables — set all of these as secrets in Replit
# (Secrets tab in the sidebar, or via the environment-secrets skill)
#
# DO NOT commit real values here. This file is a template only.

# Auth
# Generate with: openssl rand -hex 32
JWT_SECRET=your-strong-random-secret-here
SESSION_SECRET=your-strong-random-session-secret-here

# Database (Postgres)
# Full connection string used by the app at runtime
DATABASE_URL=postgres://user:password@host:5432/dbname

# Individual Postgres credentials used by Drizzle Kit (migrations / schema push)
PGHOST=localhost
PGPORT=5432
PGUSER=your-db-user
PGPASSWORD=your-db-password
PGDATABASE=your-db-name

# Runtime (set automatically by Replit workflows — do not set manually)
# PORT=<assigned by workflow>
